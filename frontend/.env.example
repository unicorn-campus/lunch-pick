# ===================================
# 런치픽 프론트엔드 환경변수 예시
# 실제 값은 .env.local에 작성 (gitignore 포함)
# ===================================

# 앱 실행 환경
NEXT_PUBLIC_APP_ENV=development

# ===================================
# 서비스별 API 호스트
# Mock 단계: Prism Mock 서버 포트
# Prod 단계: 실제 서비스 URL로 교체
# ===================================
NEXT_PUBLIC_MEMBER_HOST=http://localhost:4010
NEXT_PUBLIC_RECOMMENDATION_HOST=http://localhost:4011
NEXT_PUBLIC_PAYMENT_HOST=http://localhost:4012
NEXT_PUBLIC_AI_HOST=http://localhost:4013

# ===================================
# NextAuth.js 설정
# ===================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here

# ===================================
# 카카오 OAuth 2.0
# https://developers.kakao.com 에서 발급
# ===================================
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_CLIENT_SECRET=your-kakao-client-secret
