# ===========================
# Database (POSTGRES)
# DB_USER / DB_PASSWORD: CLAUDE.md ROOT 값 기준
# 서비스별 DB는 docker/postgres/init/ 스크립트로 자동 생성
# ===========================
DB_USER=lunchpick
DB_PASSWORD=P@ssw0rd$
DB_PORT=5432
DB_HOST=localhost

# ===========================
# Redis
# DB 0: 세션/JWT블랙리스트/Redis Streams MQ
# DB 1: member-service 캐시
# DB 2: recommendation-service 캐시
# DB 3: payment-service 캐시
# DB 4: ai-pipeline-service 캐시
# maxmemory-policy: allkeys-lru (docker-compose command에 설정)
# ===========================
REDIS_PORT=6379
REDIS_HOST=localhost

# ===========================
# Redis Streams (MQ) — 별도 MQ 서비스 없음, Redis DB 0 사용
# 토픽: subscription-events
# 발행자: payment-service / 소비자: member-service
# ===========================
REDIS_STREAMS_DB=0
REDIS_STREAMS_TOPIC=subscription-events

# ===========================
# Prism Mock 서버 (mock 프로파일)
# docker compose --profile mock up -d
# ===========================
MOCK_MEMBER_PORT=4010
MOCK_RECOMMENDATION_PORT=4011
MOCK_PAYMENT_PORT=4012
MOCK_AI_PORT=4013

# ===========================
# CORS (프론트엔드 허용 도메인)
# ===========================
FRONTEND_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ===========================
# 서비스 포트 (Spring Boot / FastAPI)
# ===========================
MEMBER_SERVICE_PORT=8081
RECOMMENDATION_SERVICE_PORT=8082
PAYMENT_SERVICE_PORT=8083
AI_PIPELINE_SERVICE_PORT=8084

# ===========================
# 카카오 OAuth2
# ===========================
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/callback/kakao
KAKAO_API_KEY=

# ===========================
# Gemini API (이미지 생성용)
# ===========================
GEMINI_API_KEY=
