# -------------------------------------------------------
# ai-pipeline-service 환경변수 템플릿
# 실제 키는 .env 파일에 입력 (버전 관리 제외)
# -------------------------------------------------------

# 앱 설정
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO

# LLM 설정 (init_chat_model에서 사용)
PRIMARY_MODEL_ID=claude-3-5-haiku-20241022
PRIMARY_MODEL_PROVIDER=anthropic
PRIMARY_MODEL_TEMPERATURE=0.3
PRIMARY_MODEL_MAX_TOKENS=1024

COLDSTART_MODEL_ID=claude-3-5-sonnet-20241022
COLDSTART_MODEL_PROVIDER=anthropic
COLDSTART_MODEL_TEMPERATURE=0.4
COLDSTART_MODEL_MAX_TOKENS=1024

REASON_MODEL_ID=claude-3-5-haiku-20241022
REASON_MODEL_PROVIDER=anthropic
REASON_MODEL_TEMPERATURE=0.5
REASON_MODEL_MAX_TOKENS=512

# LLM API 키
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Redis 설정 (DB 4 전용)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=4

# Circuit Breaker 설정
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT=60.0

# Rate Limiting
RATE_LIMIT_GLOBAL_PER_MINUTE=500

# LangSmith (선택 — 프롬프트 모니터링)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-key-here
# LANGCHAIN_PROJECT=ai-pipeline-service
